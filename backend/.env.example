# ---------------------------------------------------------------------------
# FCM Robot backend - local / pilot configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- LiveKit SFU -----------------------------------------------------------
LIVEKIT_VERSION=v1.9.0
LIVEKIT_API_KEY=devkey
# Must be >= 32 chars. Avoid '|' and '&' (used by the config templater).
LIVEKIT_API_SECRET=devsecret-change-me-please-32-chars-min
# Private address the SFU advertises to agents (VM 1 private IP in Azure).
NODE_IP=127.0.0.1
# Agent-facing URL (private, inside the VNet).
LIVEKIT_URL=ws://livekit:7880
# Client-facing URL returned by the Token API (public, via the proxy).
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- TURN (embedded in livekit-server) -------------------------------------
TURN_ENABLED=false
TURN_DOMAIN=turn.example.com
# true when the proxy terminates TLS and forwards to the TURN listener.
TURN_EXTERNAL_TLS=true
TURN_UDP_PORT=3478
TURN_TLS_PORT=5349

# --- Reverse proxy (L4 SNI on 443) -----------------------------------------
API_DOMAIN=api.example.com
LIVEKIT_DOMAIN=livekit.example.com
TURN_UPSTREAM=livekit:5349
TOKEN_API_UPSTREAM=token-api:8080
LIVEKIT_UPSTREAM=livekit:7880

# --- Token API -------------------------------------------------------------
TOKEN_TTL_SECONDS=900
# Leave empty to use LIVEKIT_API_KEY / LIVEKIT_API_SECRET from this file.
KEY_VAULT_URL=
LIVEKIT_API_KEY_SECRET_NAME=livekit-api-key
LIVEKIT_API_SECRET_SECRET_NAME=livekit-api-secret
# Pilot-only static device registry: "device_id:secret,device_id:secret"
DEVICE_REGISTRY=robot-001:change-me-robot-001,robot-002:change-me-robot-002
REVOKED_DEVICES=
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_SESSIONS_PER_DEVICE=1

# --- Agent worker ----------------------------------------------------------
AGENT_NAME=fcm-agent
# Model providers are OpenAI-compatible; swap the base URLs for your vendor.
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
MODEL_TIMEOUT_SECONDS=10
ASSISTANT_INSTRUCTIONS=You are a friendly robot assistant. Keep answers short and speak naturally.
DATABASE_URL=postgresql://fcm:fcm_dev_password@postgres:5432/fcm

# --- Dev database ----------------------------------------------------------
POSTGRES_PASSWORD=fcm_dev_password
